<view class="page-shell">
  <view wx:if="{{loading}}" class="state card">
    <text class="eyebrow">AOTD</text>
    <view class="state-title">正在生成今晚歌单...</view>
    <view class="muted">我们正在根据你的三题答案整理今晚的情绪路线。</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="state card">
    <text class="eyebrow">暂时失败</text>
    <view class="state-title">{{errorMessage}}</view>
    <view class="actions">
      <button class="action-primary" bindtap="handleRetry">重新生成</button>
      <button class="action-secondary" bindtap="handleRestart">回到问答</button>
    </view>
  </view>

  <block wx:else>
    <view class="result-tabs card">
      <view
        class="result-tab {{activeTab === 'playlist' ? 'result-tab--active' : ''}}"
        data-tab="playlist"
        bindtap="handleSwitchTab"
      >
        AOTD歌单
      </view>
      <view
        class="result-tab {{activeTab === 'my-aotd' ? 'result-tab--active' : ''}}"
        data-tab="my-aotd"
        bindtap="handleSwitchTab"
      >
        我的AOTD
      </view>
    </view>

    <block wx:if="{{activeTab === 'playlist'}}">
      <view class="cover card">
        <view class="cover-shell">
          <view class="cover-mark">
            <text class="eyebrow">Tonight Album</text>
            <text class="cover-badge">AOTD</text>
          </view>
          <view class="cover-body">
            <view class="cover-profile">
              <image wx:if="{{profileAvatarUrl}}" class="cover-avatar" src="{{profileAvatarUrl}}" mode="aspectFill"></image>
              <view class="cover-identity">
                <view class="cover-name">{{profileNickname}}</view>
                <view class="cover-caption">今晚由你亲自开场</view>
              </view>
            </view>
            <view class="cover-title">{{result.playlist.title}}</view>
            <view class="cover-subtitle muted">{{result.playlist.subtitle}}</view>
            <view class="cover-meta">
              <text class="cover-chip">{{result.playlist.tracks.length}} 首曲目</text>
              <text class="cover-chip">首推 {{result.playlist.tracks[0].song.title}}</text>
              <text class="cover-chip">先听再往下翻</text>
            </view>
          </view>
        </view>
      </view>

      <view class="tracks">
        <text class="eyebrow">Tonight Queue</text>
        <view
          wx:for="{{result.playlist.tracks}}"
          wx:key="rank"
          class="track card"
        >
          <view class="track-main">
            <view class="track-rank">#{{item.rank}}</view>
            <view class="track-copy">
              <view class="track-title-row">
                <view class="track-title">{{item.song.title}}</view>
                <view wx:if="{{item.moodTag}}" class="track-moodtag">{{item.moodTag}}</view>
              </view>
              <view class="track-artist muted">{{item.song.artist}}</view>
              <view class="track-keyword">搜索词：{{item.song.cliKeyword || item.song.title + ' ' + item.song.artist}}</view>
            </view>
          </view>
          <view class="track-actions">
            <view
              wx:if="{{supportsInlineAudio}}"
              class="play-button {{playingTrackIndex === index ? 'play-button--active' : ''}} {{loadingTrackIndex === index ? 'play-button--loading' : ''}}"
              data-index="{{index}}"
              bindtap="handlePlayTrack"
            >
              {{
                loadingTrackIndex === index
                  ? '正在缓冲...'
                  : playingTrackIndex === index
                    ? '暂停15秒试听'
                    : '15秒试听'
              }}
            </view>
            <view class="copy-button {{copiedTrackIndex === index ? 'copy-button--active' : ''}}" data-index="{{index}}" bindtap="handleCopyTrackKeyword">
              {{copiedTrackIndex === index ? '已复制歌名' : '复制歌名'}}
            </view>
          </view>
        </view>
      </view>

      <view class="result-primary-action">
        <view class="report-entry card {{posterGenerating ? 'report-entry--disabled' : ''}}" bindtap="handleGeneratePoster">
          <view class="report-entry__copy">
            <text class="report-entry__eyebrow">AOTD Report</text>
            <text class="report-entry__title">{{posterGenerating ? '正在生成 AOTD 报告' : '生成 AOTD 报告'}}</text>
            <text class="report-entry__desc">把今晚歌单整理成一张陪伴报告~</text>
          </view>
          <view class="report-entry__cta">{{posterGenerating ? '请稍候' : reportEntryCtaText}}</view>
        </view>
      </view>
      <view class="result-secondary-actions">
        <view class="result-action-pill result-action-pill--accent reminder-button {{reminderEnabled ? 'reminder-button--active' : ''}}" bindtap="handleSubscribeReminder">
          <view class="reminder-button__content">
            <text class="reminder-button__label">{{reminderEnabled ? '继续陪伴已开启' : (reminderLoading ? reminderLoadingText : '继续陪伴')}}</text>
            <text wx:if="{{reminderEnabled}}" class="reminder-button__meta">每天下班提醒你</text>
          </view>
        </view>
        <view class="result-action-pill result-action-pill--quiet" bindtap="handleRestart">重新回答</view>
      </view>
      <view wx:if="{{!reminderEnabled}}" class="result-action-hint muted">
        {{reminderEnabled ? reminderTimeText + ' 会提醒你回来' : '开启后会在明天 18:00 提醒你回来'}}
      </view>
    </block>

    <block wx:else>
      <view class="make-card card">
        <text class="eyebrow">AOTD Song Lab</text>
        <view class="make-title">先定这首小歌的标题</view>
        <view class="make-desc">参考这次 5 首歌的氛围，先把标题定下来，再选一个你想听到的人声方向。</view>
        <view wx:if="{{stylePreview && stylePreview.summary}}" class="style-preview-card">
          <view class="style-preview-card__eyebrow">预估命中曲风</view>
          <view class="style-preview-card__title">{{stylePreview.summary}}</view>
          <view class="style-preview-card__desc">{{stylePreview.reason}}</view>
        </view>
        <input
          class="title-input"
          value="{{titleText}}"
          maxlength="40"
          placeholder="比如：今晚先抱抱自己"
          bindinput="handleSongTitleInput"
        />
        <view class="title-meta {{titleText.length >= titleMaxLength ? 'title-meta--limit' : ''}}">
          <text>最多 {{titleMaxLength}} 个字</text>
          <text>{{titleText.length}}/{{titleMaxLength}}</text>
        </view>
      </view>

      <view class="make-card make-card--compact card">
        <text class="eyebrow">Voice & Generate</text>
        <view class="section-title">选一个小歌的人声</view>
        <view class="make-desc make-desc--compact">选好人声后，直接按这个方向把今晚的小歌做出来。</view>
        <view class="vocal-options">
          <view
            wx:for="{{vocalOptions}}"
            wx:key="value"
            class="vocal-option {{selectedVocalProfile === item.value ? 'vocal-option--active' : ''}}"
            data-value="{{item.value}}"
            bindtap="handleSelectVocalProfile"
            hover-class="vocal-option--hover"
          >
            <view class="vocal-option__head">
              <view class="vocal-option__title">{{item.label}}</view>
              <view wx:if="{{selectedVocalProfile === item.value}}" class="vocal-option__badge">已选</view>
            </view>
            <view class="vocal-option__desc">{{item.description}}</view>
          </view>
        </view>
        <button class="action-primary generate-action {{generatingSong ? 'action-primary--disabled' : ''}}" disabled="{{generatingSong || !selectedVocalProfile}}" bindtap="handleGenerateMyAotd">
          {{generatingSong ? generationText : '开始制作我的 AOTD'}}
        </button>
        <view wx:if="{{showGenerationProgress}}" class="generation-progress">
          <view class="generation-progress__head">
            <text class="generation-progress__title">{{generationProgressText}}</text>
            <text class="generation-progress__percent">{{generationProgressPercent}}%</text>
          </view>
          <view class="generation-progress__track">
            <view class="generation-progress__fill" style="width: {{generationProgressPercent}}%;"></view>
            <view class="generation-progress__notes">
              <view wx:for="{{generationProgressSteps}}" wx:key="label" class="generation-note {{index <= generationProgressStepIndex ? 'generation-note--active' : ''}}">
                {{index <= generationProgressStepIndex ? '🎵' : '·'}}
              </view>
            </view>
          </view>
          <view class="generation-progress__labels">
            <text
              wx:for="{{generationProgressSteps}}"
              wx:key="label"
              class="generation-progress__label {{index === generationProgressStepIndex ? 'generation-progress__label--active' : ''}}"
            >
              {{item.label}}
            </text>
          </view>
        </view>
      </view>

      <view wx:if="{{songResult}}" class="make-card card">
        <text class="eyebrow">Result</text>
        <view class="section-title">{{songResult.title || '我的 AOTD 小歌'}}</view>
        <view wx:if="{{songResult.styleSummary}}" class="result-style-chip">命中曲风：{{songResult.styleSummary}}</view>
        <view wx:if="{{songResult.styleReason}}" class="result-style-reason">{{songResult.styleReason}}</view>
        <view class="result-desc">{{songResult.summary}}</view>
        <view class="result-meta">{{songMetaText}}</view>
        <view class="result-actions">
          <button class="action-primary" disabled="{{loadingSong}}" bindtap="handleToggleGeneratedSongPlay">{{loadingSong ? '加载中' : (playingSong ? '暂停播放' : '播放小歌')}}</button>
        </view>
        <view class="result-note muted">{{generationNote}}</view>
      </view>
    </block>

    <view wx:if="{{showPosterPreview}}" class="poster-preview-mask" catchtouchmove="noop">
      <view class="poster-preview-sheet card">
        <view class="poster-preview-head">
          <view class="poster-preview-title">AOTD 报告</view>
          <view class="poster-preview-close" bindtap="handleClosePosterPreview">关闭</view>
        </view>
        <image wx:if="{{posterImagePath}}" class="poster-preview-image" src="{{posterImagePath}}" mode="widthFix"></image>
        <view class="poster-preview-actions">
          <button class="action-primary" bindtap="handleSavePoster">保存到本地</button>
          <button class="action-secondary" bindtap="handleClosePosterPreview">先不保存</button>
        </view>
      </view>
    </view>

    <canvas id="aotdPosterCanvas" type="2d" class="poster-canvas"></canvas>
  </block>
</view>
