.state,
.cover,
.track {
  margin-top: 18rpx;
  padding: 30rpx;
}

.state-title,
.cover-title {
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 600;
}

.state {
  display: flex;
  flex-direction: column;
}

.state-title {
  margin-top: 16rpx;
}

.state .muted,
.state .actions {
  margin-top: 16rpx;
}

.cover {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 18rpx 36rpx rgba(225, 156, 182, 0.18);
}

.cover-shell {
  padding: 34rpx 30rpx;
  background:
    radial-gradient(circle at 18% 18%, rgba(255, 243, 247, 0.96) 0%, rgba(255, 243, 247, 0) 34%),
    radial-gradient(circle at 86% 14%, rgba(243, 214, 225, 0.9) 0%, rgba(243, 214, 225, 0) 28%),
    linear-gradient(160deg, rgba(255, 249, 251, 0.98) 0%, rgba(250, 235, 241, 0.98) 100%);
}

.cover-mark {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.cover-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #b86b88;
  font-size: 22rpx;
  letter-spacing: 0.18em;
}

.cover-body {
  margin-top: 42rpx;
}

.cover-profile {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.cover-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(225, 156, 182, 0.18);
  flex: none;
}

.cover-identity {
  min-width: 0;
}

.cover-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #6a4757;
  line-height: 1.3;
}

.cover-caption {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(106, 71, 87, 0.72);
}

.cover-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.18;
  color: #4b3740;
}

.cover-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.cover-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.cover-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #926376;
  font-size: 22rpx;
}

.tracks {
  display: block;
}

.track-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.track-rank {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 241, 246, 0.92);
  color: #ce7493;
  font-size: 24rpx;
}

.track-copy { flex: 1; }

.track-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: space-between;
  min-width: 0;
}

.track-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #513d47;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-artist {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.track-keyword {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 246, 249, 0.92);
  color: rgba(109, 84, 94, 0.82);
  font-size: 22rpx;
  line-height: 1.5;
}

.track-moodtag {
  flex: none;
  align-self: center;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(229, 139, 168, 0.08) 0%, rgba(206, 116, 147, 0.05) 100%);
  color: #8f4d68;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  line-height: 1.5;
  border: 1rpx solid rgba(229, 139, 168, 0.22);
  white-space: nowrap;
}

.copy-button {
  flex: 1;
  min-height: 84rpx;
  border-radius: 999rpx;
  background: rgba(229, 139, 168, 0.12);
  color: #9d5974;
  border: 1rpx solid rgba(229, 139, 168, 0.32);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.copy-button--active {
  background: linear-gradient(135deg, rgba(255, 237, 244, 0.98) 0%, rgba(252, 229, 238, 0.98) 100%);
  border-color: rgba(229, 139, 168, 0.58);
  color: #8f536c;
}

.copy-button--single {
  width: 100%;
}

.track-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.play-button {
  flex: 1;
  min-height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #e58ba8 0%, #ce7493 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 24rpx rgba(229, 139, 168, 0.22);
}

.play-button--active {
  background: linear-gradient(135deg, #d87597 0%, #bf6988 100%);
}

.play-button--loading {
  background: linear-gradient(135deg, #e8a3b8 0%, #d989a5 100%);
}

.actions {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}

.actions .action-primary,
.actions .action-secondary {
  margin-top: 16rpx;
}

.result-primary-action {
  width: 700rpx;
  margin-top: 30rpx;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
}

.result-secondary-actions {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 20rpx;
}

.result-secondary-actions .result-action-pill {
  flex: 1;
  min-width: 0;
}

.result-action-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.song-lab-entry {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.song-lab-entry__copy {
  flex: 1;
  min-width: 0;
}

.song-lab-entry__eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(191, 103, 140, 0.68);
}

.song-lab-entry__title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #4e3943;
}

.song-lab-entry__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(94, 72, 82, 0.76);
}

.song-lab-entry__cta {
  flex: none;
  font-size: 24rpx;
  color: #b15b7f;
  font-weight: 600;
  white-space: nowrap;
}

.report-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at top left, rgba(255, 244, 248, 0.96) 0%, rgba(255, 244, 248, 0) 34%),
    linear-gradient(135deg, rgba(255, 250, 252, 0.98) 0%, rgba(250, 236, 242, 0.98) 100%);
  border: 1rpx solid rgba(224, 177, 196, 0.34);
  box-shadow: 0 18rpx 34rpx rgba(210, 144, 171, 0.14);
}

.report-entry--disabled {
  opacity: 0.76;
}

.report-entry__copy {
  flex: 1;
  min-width: 0;
}

.report-entry__eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(191, 103, 140, 0.72);
}

.report-entry__title {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #513b45;
}

.report-entry__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(93, 68, 79, 0.74);
}

.report-entry__cta {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b15b7f;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.result-action-pill {
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.result-action-pill--accent {
  border: 1rpx solid rgba(217, 110, 148, 0.2);
  background: linear-gradient(135deg, rgba(255, 242, 247, 0.98) 0%, rgba(251, 229, 238, 0.98) 100%);
  color: #a45674;
  box-shadow: 0 12rpx 24rpx rgba(229, 139, 168, 0.1);
}

.result-action-pill--quiet {
  border: 1rpx solid rgba(214, 186, 197, 0.4);
  background: rgba(255, 249, 252, 0.84);
  color: #5b4751;
}

.reminder-button__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100%;
}

.reminder-button__label {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.reminder-button__meta {
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(177, 91, 127, 0.86);
}

.result-secondary-actions .reminder-button--active {
  background: linear-gradient(135deg, rgba(250, 233, 240, 0.98) 0%, rgba(246, 222, 232, 0.98) 100%);
  color: #b15b7f;
  border-color: rgba(217, 110, 148, 0.28);
  box-shadow: 0 10rpx 22rpx rgba(217, 110, 148, 0.12);
}

.poster-canvas {
  position: fixed;
  left: 9000px;
  top: 0;
  width: 720px;
  height: 1080px;
  opacity: 0;
  pointer-events: none;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(27, 20, 24, 0.56);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.poster-preview-sheet {
  width: 100%;
  max-height: 92vh;
  overflow: hidden;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
}

.poster-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.poster-preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4b3740;
}

.poster-preview-close {
  font-size: 24rpx;
  color: rgba(75, 55, 64, 0.7);
}

.poster-preview-image {
  width: 100%;
  border-radius: 24rpx;
  background: rgba(255, 247, 250, 1);
}

.poster-preview-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}
